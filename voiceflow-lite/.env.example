# VoiceFlow-Lite configuration template.
# Copy this file to ".env" and paste your Gemini API key after the "=".
# ".env" is git-ignored, so the key never reaches the repository.
GEMINI_API_KEY=

# Optional overrides. The defaults work for most people.
# VOICEFLOW_HOME=
# VOICEFLOW_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
