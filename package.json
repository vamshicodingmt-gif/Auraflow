{
  "name": "auraflow",
  "productName": "AuraFlow",
  "version": "1.0.0",
  "private": true,
  "description": "AuraFlow (Goth Edition) — a gothic voice-dictation utility for the desktop. Press Alt+Space (Option+Space on macOS), speak, and polished text is pasted into whatever you are typing in. Powered by your Gemini API key.",
  "author": "AuraFlow contributors",
  "main": "dist-electron/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "icons": "python3 scripts/generate_icons.py"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/unifrakturmaguntia": "^5.2.0",
    "@types/node": "^22.19.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
